---
interface Props {
  title: string;
  text?: string;
  button?: string;
  href?: string;
  image: string;
}
const { title, text = "We're ready to turn your ideas into reality!", button = 'Contact Us Now!', href = '/contact', image } = Astro.props;
---
<section class="cta">
  <img src={image} alt="" loading="lazy" />
  <div class="container inner">
    <h2 class="h-lg">{title}</h2>
    {text && <p class="lead">{text}</p>}
    <a class="btn btn-primary" href={href}>{button}</a>
  </div>
</section>

<style>
  .cta { position: relative; isolation: isolate; overflow: hidden; min-height: 460px; display: grid; place-items: center; text-align: center; }
  .cta img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .cta::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, var(--bg) 0%, rgba(0,4,13,.35) 30%, rgba(0,4,13,.35) 70%, var(--bg) 100%); }
  .inner { display: flex; flex-direction: column; align-items: center; gap: 18px; padding-block: 80px; }
  .lead { margin: 0 auto 10px; }
  .btn { min-width: 240px; }
</style>
