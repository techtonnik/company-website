---
import type { ShowcaseItem } from '../data/showcase';
import { isExternal } from '../lib/rich';
import Icon from './Icon.astro';

interface Props { item: ShowcaseItem }
const { item } = Astro.props;
const [primary, secondary] = item.links;
const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});
---
<article class="showcase">
  <img class="bg" src={item.bg} alt="" loading="lazy" />
  <div class="body">
    {item.logo && <img class="logo" src={item.logo} alt="" loading="lazy" />}
    <h2 class="h-lg">{item.title}</h2>
    <h3 class="tagline">{item.tagline}</h3>
    <p>{item.text}</p>
    <div class="btn-row">
      {item.comingSoon && <span class="btn btn-light" aria-disabled="true">Coming Soon!</span>}
      {primary && <a class="btn btn-light" href={primary.href} {...ext(primary.href)}>{primary.label}</a>}
      {secondary && (
        <a class="btn btn-ghost on-dark" href={secondary.href} {...ext(secondary.href)}>
          {secondary.label} <Icon name="chevrons" size={20} />
        </a>
      )}
    </div>
  </div>
  {item.shot && <img class="shot" src={item.shot} alt={`${item.title} preview`} loading="lazy" />}
</article>

<style>
  .showcase {
    position: relative; isolation: isolate; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 32px;
    min-height: 560px; padding: clamp(28px, 4.5vw, 56px);
    border: 2px solid rgba(255, 255, 255, .14); border-radius: var(--radius-lg);
    background: #050a14;
  }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .showcase::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(0,4,13,.82) 0%, rgba(0,4,13,.55) 55%, rgba(0,4,13,.25) 100%); }
  .logo { max-height: 96px; max-width: 300px; width: auto; margin-bottom: 24px; object-fit: contain; object-position: left; }
  .tagline { margin-top: 10px; font-size: clamp(1.15rem, 1.8vw, 1.4rem); font-weight: 500; }
  .body p { margin-top: 16px; max-width: 34rem; color: var(--text); opacity: .9; }
  .shot { justify-self: center; max-height: 420px; width: auto; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,0,0,.5)); }
  [aria-disabled] { cursor: default; opacity: .9; }
  @media (max-width: 820px) {
    .showcase { grid-template-columns: 1fr; min-height: 0; }
    .shot { order: -1; max-height: 260px; }
    .showcase::before { background: rgba(0,4,13,.72); }
  }
</style>
