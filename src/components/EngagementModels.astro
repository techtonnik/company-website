---
import { engagementModels } from '../data/site';
import Icon from './Icon.astro';
---
<section class="section container">
  <div class="center head">
    <h2 class="h-lg">Models Of Engagement</h2>
    <p>We offer three distinct ways of collaboration. We'll help you pick and choose the one that's best suited for your project</p>
  </div>
  <div class="grid grid-3">
    {engagementModels.map((m) => (
      <div class="card model">
        <Icon name={m.icon} size={40} class="icon" />
        <h3 class="h-sm">{m.title}</h3>
        <p>{m.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .head { max-width: 40rem; margin: 0 auto 56px; }
  .head p { margin-top: 14px; font-weight: 500; }
  .model { position: relative; text-align: center; padding: 56px 28px 40px; min-height: 260px; }
  .model :global(.icon) { position: absolute; top: 18px; right: 22px; }
  .model h3 { margin-bottom: 16px; }
  .model p { font-size: .95rem; font-weight: 500; }
</style>
