---
import { testimonials } from '../data/site';
import { partners } from '../data/showcase';
import Icon from './Icon.astro';

// Partner testimonials first, then client testimonials. Placeholders are skipped,
// and a person quoted in both lists only appears once (as a partner).
const fromPartners = partners
  .filter((p) => !p.placeholder && p.avatar)
  .map((p) => {
    const [name, ...role] = p.author.split(', ');
    return { name, role: role.join(', '), img: p.avatar!, quote: p.quote.replace(/^"|"$/g, '') };
  });
const names = new Set(fromPartners.map((t) => t.name));
const all = [...fromPartners, ...testimonials.filter((t) => !names.has(t.name))];
---
<section class="section container">
  <div class="section-head">
    <h2 class="h-lg">Proof that our work is <span class="hl">top-notch</span></h2>
    <a class="btn btn-primary" href="/contact">Let's Work</a>
  </div>
  <div class="card carousel" data-carousel>
    <Icon name="quote" size={44} class="mark" />
    <div class="slides">
      {all.map((t, i) => (
        <figure class="slide" data-slide hidden={i !== 0}>
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <img src={t.img} alt="" width="64" height="64" loading="lazy" />
            <span>
              <strong>{t.name}</strong>
              <span class="role">{t.role}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="controls">
      <button type="button" data-prev aria-label="Previous testimonial"><Icon name="arrow-left" size={22} /></button>
      <span class="count" aria-live="polite"><span data-index>1</span> / {all.length}</span>
      <button type="button" data-next aria-label="Next testimonial"><Icon name="arrow" size={22} /></button>
    </div>
  </div>
</section>

<style>
  .carousel { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 24px 40px; padding: clamp(28px, 4vw, 48px); }
  .carousel :global(.mark) { position: absolute; top: 22px; right: 28px; color: var(--accent); opacity: .35; }
  /* All slides share one grid cell, so the card is always as tall as the longest quote and never jumps. */
  .slides { display: grid; }
  .slide { grid-area: 1 / 1; display: flex; flex-direction: column; margin: 0; }
  .slide[hidden] { display: flex; visibility: hidden; }
  blockquote { margin: 0; max-width: 52rem; font: 500 clamp(1.1rem, 1.7vw, 1.4rem)/1.5 var(--font-body); }
  figcaption { display: flex; align-items: center; gap: 14px; margin-top: auto; padding-top: 24px; }
  figcaption img { flex: none; width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); box-shadow: var(--glow); }
  figcaption strong { display: block; font: 600 1.1rem var(--font-head); }
  .role { display: block; font-size: .88rem; color: var(--accent); }
  .controls { display: flex; align-items: center; gap: 12px; }
  .controls button { display: grid; place-items: center; width: 44px; height: 44px; border: 2px solid var(--line); border-radius: 50%; background: none; color: var(--accent); cursor: pointer; transition: border-color .2s, background .2s; }
  .controls button:hover { border-color: var(--accent); background: rgba(3, 169, 244, .1); }
  .count { min-width: 4.5ch; text-align: center; font-size: .85rem; color: var(--text-muted); }
  @media (max-width: 720px) {
    .carousel { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .carousel :global(.mark) { position: static; }
    figcaption { flex-direction: column; gap: 10px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const index = root.querySelector<HTMLElement>('[data-index]')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, j) => (s.hidden = j !== i));
      index.textContent = String(i + 1);
    };
    root.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
  });
</script>
