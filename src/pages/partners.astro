---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import { heroVideos, ctaBackgrounds } from '../data/site';
import { partners } from '../data/showcase';
import { isExternal } from '../lib/rich';

const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});
---
<Base title="Partners | Techtonnik" description="Our partner list keeps expanding - Discover why that’s the case!">
  <Hero video={heroVideos.space} short>
    <h1 class="h-lg">Trusted Partners, Shared Success!</h1>
    <p class="lead">Our partner list keeps expanding - Discover why that’s the case!</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/contact">Become Our Partner!</a>
      <a class="btn btn-ghost" href="/case-studies">Case Studies <Icon name="chevrons" size={20} /></a>
    </div>
  </Hero>

  <section class="section container list">
    {partners.map((p, i) => (
      <article class:list={['partner', { flip: i % 2 === 1 }]}>
        <a class="shot" href={p.mockup.url} target="_blank" rel="noopener">
          <DeviceMockup
            desktop={`/mockups/${p.mockup.name}-desktop.jpg`}
            mobile={`/mockups/${p.mockup.name}-mobile.jpg`}
            url={p.mockup.url}
            tint={p.mockup.tint}
            alt={`${p.logoAlt} website`}
          />
        </a>
        <div class="body">
          <img class="logo" src={p.logo} alt={p.logoAlt} loading="lazy" />
          <h2 class="h-md">{p.title}</h2>
          <p class="text">{p.text}</p>
          <div class="links">
            <a class="btn btn-primary" href={p.links[0].href} {...ext(p.links[0].href)}>{p.links[0].label}</a>
            <a class="btn btn-ghost" href={p.links[1].href} {...ext(p.links[1].href)}>{p.links[1].label} <Icon name="arrow" size={18} /></a>
          </div>
          <figure class:list={['quote', { placeholder: p.placeholder }]}>
            {p.avatar
              ? <img src={p.avatar} alt="" width="52" height="52" loading="lazy" />
              : <span class="avatar-fallback" aria-hidden="true">{p.logoAlt[0]}</span>}
            <figcaption>
              <blockquote>{p.quote}</blockquote>
              <p>{p.author}</p>
            </figcaption>
          </figure>
        </div>
      </article>
    ))}
  </section>

  <Cta title="Are YOU Our Next Partner?" text="We're always open to working with great teams." button="Get in Touch" image={ctaBackgrounds.earth} />
</Base>

<style>
  :global(main .hero.short) { min-height: 400px; }
  :global(main .hero-content) { padding-top: 96px; padding-bottom: 40px; }

  .list { display: flex; flex-direction: column; gap: 20px; }
  .partner {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); align-items: center;
    padding: clamp(14px, 1.6vw, 20px); border: 2px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-raised);
    transition: border-color .2s;
  }
  .partner:hover { border-color: var(--accent); }
  .flip .shot { order: 2; }
  .shot { display: block; border-radius: var(--radius); overflow: hidden; }
  .shot :global(.mockup) { transition: transform .3s; }
  .shot:hover :global(.mockup) { transform: scale(1.02); }

  .body { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 8px clamp(4px, 1.5vw, 16px); }
  .logo { height: 40px; width: auto; max-width: 220px; object-fit: contain; object-position: left; margin-bottom: 6px; }
  .logo[alt='Cinnamon'] { height: 26px; }
  .logo[alt='Cognitika'] { height: 44px; }
  .text { font-size: .92rem; color: var(--text-muted); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; margin-top: 6px; }
  .links .btn-ghost { padding-inline: 0; }

  .quote { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 14px; align-items: start; width: 100%; margin: 14px 0 0; padding-top: 16px; border-top: 1px solid var(--line); }
  .quote img, .avatar-fallback { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); }
  .avatar-fallback { display: grid; place-items: center; border-style: dashed; font: 700 1.3rem var(--font-head); color: var(--accent); }
  .quote blockquote { margin: 0; font-size: .88rem; font-style: italic; }
  .quote p { margin-top: 6px; font-size: .78rem; font-weight: 600; color: var(--accent); }
  /* Visible on purpose so missing testimonials don't ship unnoticed. */
  .quote.placeholder { padding: 14px; border: 1px dashed var(--purple); border-radius: var(--radius); }
  .quote.placeholder blockquote, .quote.placeholder p { opacity: .75; }

  @media (max-width: 820px) {
    .partner { grid-template-columns: 1fr; }
    .flip .shot { order: 0; }
  }
</style>
