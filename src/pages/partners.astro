---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Icon from '../components/Icon.astro';
import { heroVideos, ctaBackgrounds } from '../data/site';
import { partners } from '../data/showcase';
import DeviceMockup from '../components/DeviceMockup.astro';
import { isExternal } from '../lib/rich';

const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});
---
<Base title="Partners | Techtonnik" description="Our partner list keeps expanding - Discover why that’s the case!">
  <Hero video={heroVideos.space} short>
    <h1 class="h-lg">Trusted Partners, Shared Success!</h1>
    <p class="lead">Our partner list keeps expanding - Discover why that’s the case!</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/contact">Become Our Partner!</a>
      <a class="btn btn-ghost" href="/case-studies">Case Studies <Icon name="chevrons" size={20} /></a>
    </div>
  </Hero>
  <Marquee />

  <div class="container list">
    {partners.map((p, i) => (
      <article class:list={['partner', { flip: i % 2 === 1 }]}>
        <div class="col media-col">
          <a class="panel shot" href={p.mockup.url} target="_blank" rel="noopener">
            <DeviceMockup
              desktop={`/mockups/${p.mockup.name}-desktop.jpg`}
              mobile={`/mockups/${p.mockup.name}-mobile.jpg`}
              url={p.mockup.url}
              tint={p.mockup.tint}
              alt={`${p.logoAlt} website`}
            />
          </a>
          <figure class:list={['quote', { placeholder: p.placeholder }]}>
            {p.avatar
              ? <img src={p.avatar} alt="" width="154" height="157" loading="lazy" />
              : <span class="avatar-fallback" aria-hidden="true">{p.logoAlt[0]}</span>}
            <figcaption>
              <blockquote>{p.quote}</blockquote>
              <p class="hl">{p.author}</p>
            </figcaption>
          </figure>
        </div>
        <div class="col info-col">
          <div class="panel logo"><img src={p.logo} alt={p.logoAlt} loading="lazy" /></div>
          <div class="panel info">
            <h2 class="h-md">{p.title}</h2>
            <p>{p.text}</p>
            <div class="btn-row">
              <a class="btn btn-light accent-text" href={p.links[0].href} {...ext(p.links[0].href)}>{p.links[0].label}</a>
              <a class="btn btn-ghost on-dark" href={p.links[1].href} {...ext(p.links[1].href)}>{p.links[1].label} <Icon name="arrow" size={20} /></a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <section class="cta-strip">
    <img src={ctaBackgrounds.earth} alt="" loading="lazy" />
    <div class="container inner">
      <h2 class="h-lg">Are YOU Our Next Partner?</h2>
      <a class="btn btn-light accent-text" href="/contact">Contact Us</a>
    </div>
  </section>
</Base>

<style>
  :global(main .hero.short) { min-height: 440px; }
  :global(main .hero-content) { padding-top: 96px; padding-bottom: 40px; }
  .list { display: flex; flex-direction: column; gap: 32px; padding-block: 40px; }
  .partner { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .col { display: flex; flex-direction: column; gap: 14px; }
  .flip .media-col { order: 2; }
  .panel { border: 2px solid var(--accent); border-radius: var(--radius); background: var(--accent); box-shadow: var(--glow-blue); overflow: hidden; }
  .shot { display: block; transition: transform .2s; }
  .shot:hover { transform: translateY(-2px); }
  .logo { display: grid; place-items: center; min-height: 107px; padding: 14px 28px; }
  .logo img { max-height: 80px; width: auto; object-fit: contain; }
  .logo img[alt='Cinnamon'] { max-height: 52px; }
  .info { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 28px clamp(20px, 3vw, 40px); }
  .info p { margin-top: 18px; font-size: .92rem; }
  .info .btn-row { justify-content: center; }
  .quote { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 16px; align-items: center; margin: 0; }
  .quote img { width: 96px; height: 98px; object-fit: cover; border: 2px solid var(--accent); border-radius: 6px; }
  .quote blockquote { margin: 0; font-size: .95rem; }
  .avatar-fallback { display: grid; place-items: center; width: 96px; height: 98px; border: 2px dashed var(--accent); border-radius: 6px; font: 700 2.4rem var(--font-head); color: var(--accent); }
  /* Visible on purpose so missing testimonials don't ship unnoticed. */
  .quote.placeholder { padding: 12px; border: 1px dashed var(--purple); border-radius: var(--radius); }
  .quote.placeholder blockquote, .quote.placeholder p { font-style: italic; opacity: .75; }
  .quote p { margin-top: 10px; font-size: .82rem; font-weight: 600; }
  @media (max-width: 820px) {
    .partner { grid-template-columns: 1fr; }
    .flip .media-col { order: 0; }
  }

  .cta-strip { position: relative; isolation: isolate; overflow: hidden; }
  .cta-strip img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .cta-strip::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(3, 169, 244, .55); }
  .cta-strip .inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-block: 48px; }
  .cta-strip .btn { min-width: 240px; }
</style>
