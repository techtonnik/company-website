---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { caseStudyDetails, type CaseStudyDetail } from '../../data/caseStudyDetails';
import { media } from '../../data/site';
import { rich } from '../../lib/rich';

export function getStaticPaths() {
  return caseStudyDetails.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}

const { cs } = Astro.props as { cs: CaseStudyDetail };
const [mainShot, ...thumbs] = cs.gallery;
---
<Base title={`${cs.title} | techtonnik`} description={cs.subtitle}>
  <section class="cs-hero" style={`--tint:${cs.heroColor}`}>
    <img class="bg" src={cs.hero} alt="" fetchpriority="high" />
    <div class="container inner">
      <div>
        <h1 class="h-lg">{cs.title}</h1>
        <p class="sub">{cs.subtitle}</p>
        <dl class="facts">
          <div><dt>Industry</dt><dd>{cs.industry}</dd></div>
          <div><dt>Year</dt><dd>{cs.year}</dd></div>
          <div><dt>Services</dt><dd>{cs.services}</dd></div>
        </dl>
        <a class="btn btn-light" href={cs.website} target="_blank" rel="noopener">Visit Website</a>
      </div>
      <img class="shot" src={cs.shot} alt={`${cs.title} preview`} />
    </div>
  </section>

  <section class="section container">
    <h2 class="h-lg">Case Study Overview</h2>
    <div class="overview">
      {cs.overview.map((p) => <p set:html={rich(p)} />)}
    </div>
  </section>

  <section class="section container">
    <h2 class="h-lg">Development Process</h2>
    <ol class="timeline">
      {cs.process.map((step) => (
        <li>
          <h3 class="h-md hl">{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container gallery">
    <div class="main"><img src={mainShot} alt="" loading="lazy" /></div>
    {thumbs.map((src) => <div><img src={src} alt="" loading="lazy" /></div>)}
  </section>

  <section class="section container center">
    <h2 class="h-lg">Our Tech Stack</h2>
    <p class="intro">{cs.stackIntro}</p>
    <ul class="stack">
      {cs.stack.map((t) => <li><img src={t.img} alt="" width="90" height="90" loading="lazy" /><span>{t.name}</span></li>)}
    </ul>
  </section>

  <section class="section container center">
    <h2 class="h-lg">Outcomes and Impact</h2>
    <p class="intro">Were the clients satisfied? What sort of impact did we make?</p>
    <div class="outcomes">
      {cs.outcomes.map((o) => (
        <div class="card outcome">
          <Icon name={o.icon} size={30} class="o-icon" />
          <h3 class="h-sm">{o.title}</h3>
          <p>{o.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container testimonial">
    <img src={cs.testimonial.img} alt={cs.testimonial.name} width="180" height="180" loading="lazy" />
    <div>
      <h2 class="h-md">{cs.testimonial.name}</h2>
      <p class="h-md hl">{cs.testimonial.role}</p>
      <blockquote>{cs.testimonial.quote}</blockquote>
    </div>
  </section>

  <section class="container more">
    <div class="more-box">
      <img src={media('cce622_8da603674f58454a9a6712b7860f35b0')} alt="" loading="lazy" />
      <div class="more-inner">
        <h2 class="h-lg">Is There More?</h2>
        <p>Oh yes there is! Make sure to check out our other case studies!</p>
        <a class="btn btn-primary" href="/case-studies">Let's Go!</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cs-hero { position: relative; isolation: isolate; overflow: hidden; padding: 140px 0 72px; }
  .cs-hero .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .cs-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--tint); opacity: .82; }
  .inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .sub { margin-top: 14px; max-width: 30rem; opacity: .9; }
  .facts { display: flex; flex-wrap: wrap; gap: 20px 48px; margin: 28px 0 32px; }
  .facts dt { font: 600 1.15rem var(--font-head); }
  .facts dd { margin: 2px 0 0; font-size: .85rem; font-weight: 600; }
  .shot { justify-self: center; max-height: 380px; width: auto; filter: drop-shadow(0 20px 40px rgba(0,0,0,.45)); }
  @media (max-width: 820px) { .inner { grid-template-columns: 1fr; } .shot { max-height: 240px; } }

  .overview { margin-top: 28px; display: grid; gap: 18px; max-width: 70rem; }
  .overview :global(.hl) { color: var(--text); }

  .timeline { list-style: none; margin: 48px auto 0; padding: 0; max-width: 900px; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 4px; margin-left: -2px; background: var(--accent); border-radius: 2px; }
  .timeline li { position: relative; width: 50%; padding: 0 40px 48px; }
  .timeline li:nth-child(odd) { margin-left: 50%; }
  .timeline li:nth-child(even) { text-align: right; }
  .timeline li::before { content: ''; position: absolute; top: 12px; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); }
  .timeline li:nth-child(odd)::before { left: -7px; }
  .timeline li:nth-child(even)::before { right: -7px; }
  .timeline h3 { margin-bottom: 10px; }
  .timeline p { font-size: .9rem; }
  @media (max-width: 640px) {
    .timeline::before { left: 7px; }
    .timeline li, .timeline li:nth-child(odd) { width: 100%; margin-left: 0; padding: 0 0 36px 36px; text-align: left; }
    .timeline li:nth-child(n)::before { left: 0; right: auto; }
  }

  .gallery { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 12px; }
  .gallery > div { border: 2px solid rgba(255,255,255,.7); border-radius: 8px; overflow: hidden; background: #000; aspect-ratio: 1; }
  .gallery .main { grid-row: 1 / 3; aspect-ratio: auto; display: grid; place-items: center; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; }
  .gallery .main img { object-fit: contain; padding: 24px; }
  @media (max-width: 640px) { .gallery { grid-template-columns: 1fr 1fr; } .gallery .main { grid-column: 1 / 3; grid-row: auto; } }

  .intro { margin: 14px auto 0; max-width: 30rem; font-size: .9rem; }
  .stack { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px 48px; list-style: none; margin: 40px 0 0; padding: 0; }
  .stack li { display: flex; flex-direction: column; align-items: center; gap: 10px; font-size: .8rem; font-weight: 500; }
  .stack img { width: 90px; height: 90px; object-fit: contain; }

  .outcomes { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 40px; }
  .outcome { position: relative; flex: 1 1 280px; max-width: 400px; padding: 40px 28px 32px; }
  .outcome :global(.o-icon) { position: absolute; top: 16px; right: 18px; }
  .outcome h3 { margin-bottom: 14px; font-size: 1rem; }
  .outcome p { font-size: .85rem; }

  .testimonial { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 32px; align-items: center; padding-block: 48px; }
  .testimonial img { width: 180px; height: 180px; object-fit: cover; border: 2px solid var(--accent); border-radius: 6px; box-shadow: var(--glow); }
  .testimonial blockquote { margin: 14px 0 0; font-weight: 500; max-width: 46rem; }
  @media (max-width: 640px) { .testimonial { grid-template-columns: 1fr; } .testimonial img { width: 120px; height: 120px; } }

  .more { padding-block: 40px 80px; }
  .more-box { position: relative; isolation: isolate; overflow: hidden; border: 2px solid var(--accent); border-radius: var(--radius); box-shadow: var(--glow-blue); text-align: center; }
  .more-box img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .more-box::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(3, 40, 90, .75); }
  .more-inner { padding: 80px 24px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .more-inner .btn { min-width: 240px; margin-top: 10px; }
</style>
