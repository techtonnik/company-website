---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { heroVideos, ctaBackgrounds } from '../../data/site';
import { allServices, modelDetails } from '../../data/services';

---
<Base title="Services | Techtonnik" description="Senior software development: web, mobile and desktop apps, AI integrations and technical consulting.">
  <Hero video={heroVideos.space} short>
    <h1 class="h-lg">Software development, <span class="hl">done properly</span></h1>
    <p class="lead">Web, mobile and desktop apps, AI integrations and technical guidance. Built by me, or by the right team from my network.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/contact">Get in Touch</a>
      <a class="btn btn-ghost" href="/case-studies">See Projects <Icon name="chevrons" size={20} /></a>
    </div>
  </Hero>
  <Marquee />

  <section class="section container">
    <div class="section-head">
      <div>
        <h2 class="h-lg">What I <span class="hl">do</span></h2>
        <p>Focused on software. Anything outside it, I'll point you to a partner who does it best.</p>
      </div>
    </div>
    <div class="grid grid-3 services">
      {allServices.map((s) => (
        <div class="card service">
          <Icon name={s.icon} size={32} class="s-icon" />
          <h3 class="h-sm">{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container" id="models">
    <div class="section-head">
      <div>
        <h2 class="h-lg">How we can <span class="hl">work together</span></h2>
        <p>Most of my work is ongoing and hourly, joining projects that are already moving.</p>
      </div>
    </div>
    <div class="models">
      {modelDetails.map((m, i) => (
        <article class:list={['model', { featured: i === 0 }]}>
          <div class="model-title">
            {m.tag && <span class="tag">{m.tag}</span>}
            <h3 class="h-lg">{m.title}</h3>
          </div>
          <div>
            <p>{m.text}</p>
            <ul>
              {m.benefits.map((b) => <li><Icon name="check" size={20} /> {b}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Cta title="Have a project in mind?" text="Tell me about it, and I'll make sure it ends up with the right team." button="Get in Touch" image={ctaBackgrounds.orbit} />
</Base>

<style>
  :global(main .hero.short) { min-height: 440px; }
  :global(main .hero-content) { padding-top: 96px; padding-bottom: 40px; }

  .service { display: flex; flex-direction: column; gap: 12px; }
  .service :global(.s-icon) { color: var(--accent); }
  .service p { font-size: .92rem; color: var(--text-muted); }

  .models { display: flex; flex-direction: column; gap: 16px; }
  .model { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 40px; align-items: center; padding: clamp(24px, 3.5vw, 40px); border-radius: var(--radius-lg); background: var(--bg-raised); border: 2px solid var(--line); }
  .model.featured { background: linear-gradient(135deg, #022338, #22083f); border-color: var(--purple); box-shadow: var(--glow); }
  .model-title { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .model-title h3 { color: var(--accent); }
  .tag { padding: 3px 10px; border-radius: 999px; background: var(--purple); font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  ul { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 8px; }
  li { display: flex; align-items: center; gap: 12px; font-weight: 500; }
  li :global(svg) { color: var(--accent); flex: none; }
  @media (max-width: 760px) { .model { grid-template-columns: 1fr; gap: 12px; } }

</style>
