---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { heroVideos, ctaBackgrounds } from '../../data/site';
import { servicePages, type ServicePage } from '../../data/services';
import { rich, isExternal } from '../../lib/rich';

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: ServicePage };
const [t1, t2, t3] = page.stackTitle;
---
<Base title={`${page.title} | Techtonnik`} description={page.subtitle}>
  <Hero video={heroVideos.cubes} short>
    <h1 class="h-lg">{page.title}</h1>
    <p class="lead">{page.subtitle}</p>
  </Hero>

  <section class="section container">
    <h2 class="h-lg">Why work <span class="hl">with me</span>?</h2>
    <p class="intro">{page.whyIntro}</p>
    <div class="why">
      {page.why.map((w, i) => (
        <div class:list={['card', 'why-card', { purple: i === 1 || i === 2 }]}>
          <h3 class="h-sm">{w.title}</h3>
          <p>{w.text}</p>
          <Icon name={w.icon} size={36} class="why-icon" />
        </div>
      ))}
    </div>
  </section>

  <section class="section container center">
    <h2 class="h-lg">{t1} <span class="hl">{t2}</span> {t3}</h2>
    <p class="intro narrow">{page.stackIntro}</p>
    <div class:list={['stack', { grouped: page.stack.length > 1 }]}>
      {page.stack.map((g) => (
        <div class="stack-group">
          {g.group && <h3 class="h-sm">{g.group}</h3>}
          <ul>
            {g.items.map((t) => (
              <li><img src={t.img} alt="" width="80" height="80" loading="lazy" /><span>{t.name}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <h2 class="h-lg">How Can We <span class="hl">Collaborate</span>?</h2>
    <p class="intro">{page.collabIntro}</p>
    <div class="tabs" data-tabs>
      {page.models.length > 1 && (
        <div class="tablist" role="tablist">
          {page.models.map((m, i) => (
            <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>{m.tab}</button>
          ))}
        </div>
      )}
      {page.models.map((m, i) => (
        <div class="card panel" role="tabpanel" data-panel={i} hidden={i !== 0}>
          <h3 class="h-md">{m.title}</h3>
          <p set:html={rich(m.text)} />
          <p class="note">{m.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <div>
        <h2 class="h-lg">See for <span class="hl">Yourself</span>!</h2>
        <p>{page.projectsIntro}</p>
      </div>
      <a class="btn btn-primary" href="/case-studies">All Case Studies</a>
    </div>
    <div class="grid grid-3">
      {page.projects.map((p) => (
        <a class="project" href={p.href} {...(isExternal(p.href) ? { target: '_blank', rel: 'noopener' } : {})}>
          <img src={p.img} alt="" loading="lazy" />
          <h3 class="h-sm">{p.title} <Icon name="external" size={18} /></h3>
          <p>{p.text}</p>
        </a>
      ))}
    </div>
  </section>

  <Faq items={page.faq} />
  <Cta title={page.cta} text="Tell me about it, and I'll make sure it ends up with the right team." button="Get in Touch" image={ctaBackgrounds.satellite} />
</Base>

<style>
  :global(main .hero.short) { min-height: 440px; }
  :global(main .hero-content) { padding-top: 96px; padding-bottom: 40px; }
  :global(main .section) { padding-block: clamp(36px, 4.5vw, 64px); }
  :global(main .section-head) { margin-bottom: clamp(20px, 2.5vw, 32px); }
  .intro { margin-top: 14px; max-width: 34rem; font-weight: 500; }
  .intro.narrow { margin-inline: auto; }
  .why { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; margin-top: 40px; }
  .why-card { position: relative; min-height: 210px; padding-bottom: 64px; }
  .why-card:nth-child(1), .why-card:nth-child(4) { grid-column: span 2; }
  .why-card:nth-child(2), .why-card:nth-child(3) { grid-column: span 3; }
  .why-card h3 { margin-bottom: 14px; }
  .why-card p { font-size: .88rem; }
  .why-card :global(.why-icon) { position: absolute; right: 20px; bottom: 18px; }
  @media (max-width: 760px) { .why { grid-template-columns: 1fr; } .why-card { grid-column: auto !important; } }

  .stack { display: flex; flex-wrap: wrap; justify-content: center; gap: 40px; margin-top: 48px; }
  .stack.grouped { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 32px; }
  .stack-group h3 { margin-bottom: 20px; }
  .stack ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px 36px; list-style: none; margin: 0; padding: 0; }
  .stack li { display: flex; flex-direction: column; align-items: center; gap: 10px; font-size: .85rem; font-weight: 500; }
  .stack img { width: 80px; height: 80px; object-fit: contain; }
  .stack:not(.grouped) img { width: 110px; height: 110px; }
  @media (max-width: 640px) { .stack.grouped { grid-template-columns: 1fr; } }

  .tabs { margin-top: 32px; }
  .tablist { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .tablist button { background: none; border: 1px solid transparent; color: var(--text); font: 500 .9rem var(--font-body); padding: 6px 16px; border-radius: 999px; cursor: pointer; }
  .tablist button[aria-selected='true'] { background: var(--accent); }
  .panel { background: #075d8c; padding: clamp(28px, 4vw, 48px); max-width: 980px; }
  .panel h3 { margin-bottom: 16px; }
  .panel p { max-width: 40rem; font-size: .95rem; }
  .panel :global(.hl) { color: var(--text); }
  .note { margin-top: 20px; opacity: .85; }

  .project img { width: 100%; aspect-ratio: 4 / 2.4; object-fit: cover; border-radius: 6px; background: var(--text); }
  .project h3 { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; }
  .project h3 :global(svg) { color: var(--accent); }
  .project p { margin-top: 8px; font-size: .9rem; }
  .project:hover h3 { color: var(--accent); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t, j) => t.setAttribute('aria-selected', String(i === j)));
        panels.forEach((p, j) => (p.hidden = i !== j));
      }),
    );
  });
</script>
