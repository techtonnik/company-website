---
// Proposal: home page repositioned around a solo senior developer + partner network.
// Not linked from the nav and excluded from search engines while under review.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Icon from '../components/Icon.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { heroVideos, ctaBackgrounds, media } from '../data/site';
import { caseStudies, partners } from '../data/showcase';

const ways = [
  {
    icon: 'calendar',
    title: 'Join your team',
    tag: 'Most common',
    text: 'I join your existing project as a senior developer, billed hourly. No fixed end date: I stay on for as long as you need, alongside your own people.',
  },
  {
    icon: 'laptop',
    title: 'Build it with me',
    text: "Starting from scratch? I'll take the product from idea to launch myself, and keep maintaining it afterwards.",
  },
  {
    icon: 'team',
    title: 'I assemble the team',
    text: 'For bigger apps, I put together the right developers, designers and QA from my network, and lead the work as your single point of contact.',
  },
  {
    icon: 'network',
    title: 'I connect you',
    text: "If another company is a better fit for what you need, I'll introduce you to them. You get the right team, even when it isn't mine.",
  },
];

const byTitle = (title: string) => caseStudies.find((c) => c.title === title)!;
const featured = [
  { ...byTitle('Ontopo'), scope: 'Frontend · Backend · QA' },
  { ...byTitle('Tennilytics'), scope: 'Web app · Mobile app · Website' },
  { ...byTitle('SerbLink'), scope: 'Full-stack platform' },
];

const strengths: Record<string, string> = {
  CodeIT: 'Established software company',
  'Zenith Digital': 'Web presentations, fast',
  Genroks: 'AI for ISO compliance',
  'kopirajter.rs': 'Copywriting & brand strategy',
  TrinitySmartIT: 'On-demand development teams',
  helixconnect: 'Innovation & NGO projects',
  Tremium: 'Software development',
};

const steps = [
  { title: 'Tell me what you need', text: 'A short call about your product, timeline and budget. No sales pitch.' },
  { title: 'I assess the fit', text: "I'll tell you honestly whether I should join your team, bring in more people, or point you to a partner." },
  { title: 'Work starts, hourly', text: 'Clear hourly rates agreed up front. No long contracts, and you only pay for the time actually spent.' },
  { title: 'Scale as you go', text: 'Add people, pause, or wrap up at any point. I stay your point of contact throughout.' },
];

const faq = [
  { q: 'Is techtonnik a company or one person?', a: ["techtonnik is me, Stevan Radovanović. I'm a software developer based in Belgrade, Serbia. Over the years I've built a network of trusted developers, designers and partner companies, which lets me take on projects far bigger than one person could handle alone."] },
  { q: 'Who actually writes the code?', a: ["Depending on the project: me, a team I put together and lead, or a partner company I introduce you to. You'll always know exactly who is working on your project before anything starts."] },
  { q: "What if my project isn't a good fit for you?", a: ["Then I'll say so, and introduce you to someone from my network who is a better fit. That's a core part of what I do, not a fallback."] },
  {
    q: 'How do you price projects?',
    a: [
      'There are three options, and I\'ll help you pick the right one:',
      '**Fixed Price:** for well-defined projects with a clear scope.',
      '**Time & Material:** for longer projects with evolving requirements.',
      '**Dedicated Team:** for ongoing work where you need a team working exclusively for you.',
    ],
  },
  { q: 'Can you take over or maintain an existing app?', a: ["Yes. Legacy codebases, half-finished projects and apps that need new features are all fair game. Reach out and we'll take a look."] },
];
---
<Base title="World-class On-Demand Software Development | techtonnik" description="Building AI-powered web, mobile and desktop apps: by joining your team, assembling the right one, or connecting you with the partner that fits your project best.">
  <meta slot="head" name="robots" content="noindex" />

  <div class="proposal-flag">Proposal: Home Page 2 · <a href="/">view current home</a></div>

  <Hero video={heroVideos.home}>
    <h1 class="h-xl">Quality solutions of the<br /> <span class="hl">highest magnitude</span></h1>
    <p class="lead">Building AI-powered web, mobile and desktop apps: by joining your team, assembling the right one, or connecting you with the partner that fits your project best.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/contact">Start a Project</a>
      <a class="btn btn-ghost" href="/partners">Meet the Network <Icon name="chevrons" size={20} /></a>
    </div>
  </Hero>

  <Marquee />

  <!-- Three ways to work -->
  <section class="section container">
    <div class="center head">
      <h2 class="h-lg">One contact, <span class="hl">four ways</span> to get it built</h2>
      <p>Most work is ongoing and hourly: joining a project that's already moving, not just delivering one-off builds.</p>
    </div>
    <div class="ways">
      {ways.map((w, i) => (
        <div class:list={['card', 'way', { purple: i === 0 }]}>
          <span class="num">0{i + 1}</span>
          <Icon name={w.icon} size={40} class="way-icon" />
          {w.tag && <span class="tag">{w.tag}</span>}
          <h3 class="h-md">{w.title}</h3>
          <p>{w.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured apps -->
  <section class="section container">
    <div class="section-head">
      <div>
        <h2 class="h-lg">Apps I've <span class="hl">helped build</span></h2>
        <p>Platforms, web and mobile apps, delivered directly or together with partners.</p>
      </div>
      <a class="btn btn-primary" href="/case-studies">All Projects</a>
    </div>
    <div class="apps">
      {featured.map((app) => (
        <a class="app" href={app.links[0]?.href ?? '/case-studies'} target="_blank" rel="noopener">
          <div class="app-media">
            <img class="app-bg" src={app.bg} alt="" loading="lazy" />
            {app.shot && <img class="app-shot" src={app.shot} alt={`${app.title} preview`} loading="lazy" />}
          </div>
          <div class="app-body">
            <p class="scope">{app.scope}</p>
            <h3 class="h-sm">{app.title} <Icon name="external" size={18} /></h3>
            <p>{app.tagline}</p>
          </div>
        </a>
      ))}
    </div>

  </section>

  <!-- Network -->
  <section class="network">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h-lg">The <span class="hl-dark">network</span> behind the work</h2>
          <p>Trusted companies and specialists I work with, and introduce clients to when they're the better fit.</p>
        </div>
        <a class="btn btn-light accent-text" href="/partners">All Partners</a>
      </div>
      <div class="partner-grid">
        {partners.map((p) => (
          <div class="partner">
            <img src={p.logo} alt={p.logoAlt} loading="lazy" />
            <p>{strengths[p.logoAlt]}</p>
          </div>
        ))}
        <a class="partner join" href="/contact">
          <span class="h-sm">Your company?</span>
          <p>Become a partner <Icon name="arrow" size={16} /></p>
        </a>
      </div>

      <h3 class="h-md steps-title">How a match works</h3>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <h4 class="h-sm">{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Testimonials />

  <!-- About -->
  <section class="section container about">
    <img src={media('cce622_48e5e8feccb34fe580821d2107417bfc')} alt="Stevan Radovanović" width="438" height="572" loading="lazy" />
    <div>
      <h2 class="h-lg">About <span class="hl">techtonnik</span></h2>
      <p>I started techtonnik to do software development properly: honest communication, clean code and long-term support. Along the way I've worked with dozens of clients and connected many of them with the people best suited to their projects.</p>
      <p>Today, techtonnik is how I work: senior development on my side, backed by a network of partners I trust, so every project ends up in the right hands.</p>
      <div class="stats">
        <div><span class="big">25+</span><span>Projects delivered</span></div>
        <div><span class="big">1000+</span><span>Years of combined experience across the network</span></div>
        <div><span class="big">7</span><span>Partner companies</span></div>
      </div>
    </div>
  </section>

  <Faq items={faq} />

  <Cta title="Got a project in mind?" text="Tell me about it, and I'll make sure it ends up with the right team." button="Start a Project" image={ctaBackgrounds.satellite} />
</Base>

<style>
  :global(main .hero) { min-height: min(76vh, 680px); }
  :global(main .section) { padding-block: clamp(36px, 4.5vw, 64px); }
  :global(main .section-head) { margin-bottom: clamp(20px, 2.5vw, 32px); }
  .proposal-flag { position: fixed; bottom: 16px; left: 16px; z-index: 60; padding: 8px 14px; border-radius: 999px; background: var(--purple); font-size: .8rem; font-weight: 600; box-shadow: var(--glow); }
  .proposal-flag a { text-decoration: underline; }

  .head { max-width: 40rem; margin: 0 auto 32px; }
  .head p { margin-top: 14px; font-weight: 500; }
  .ways { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 1080px) { .ways { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .ways { grid-template-columns: 1fr; } }
  .way { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 30px 26px; }
  .tag { padding: 3px 10px; border-radius: 999px; background: var(--purple); font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  .way :global(.way-icon) { color: var(--accent); }
  .way.purple :global(.way-icon) { color: #c48bff; }
  .num { position: absolute; top: 22px; right: 26px; font: 700 2.2rem/1 var(--font-head); opacity: .18; }
  .way p { font-size: .95rem; }

  .apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .app { display: flex; flex-direction: column; border: 2px solid rgba(255,255,255,.14); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-raised); transition: border-color .2s, transform .2s; }
  .app:hover { border-color: var(--accent); transform: translateY(-3px); }
  .app-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; display: grid; place-items: center; }
  .app-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(.45); }
  .app-shot { position: relative; max-height: 82%; width: auto; filter: drop-shadow(0 12px 24px rgba(0,0,0,.5)); }
  .app-body { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 6px; }
  .app-body h3 { display: flex; justify-content: space-between; align-items: center; }
  .app-body h3 :global(svg) { color: var(--accent); }
  .app-body p:last-child { font-size: .9rem; color: var(--text-muted); }
  .scope { font-size: .75rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--accent); }
  @media (max-width: 900px) { .apps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .apps { grid-template-columns: 1fr; } }


  .network { background: var(--accent); padding-block: clamp(40px, 5vw, 64px); margin-block: clamp(20px, 3vw, 40px); }
  .network .section-head p { font-weight: 500; }
  .hl-dark { color: var(--bg); }
  .partner-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .partner { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; min-height: 160px; padding: 24px 18px; border-radius: var(--radius); background: rgba(0, 4, 13, .22); text-align: center; }
  .partner img { max-height: 52px; max-width: 80%; width: auto; object-fit: contain; }
  .partner p { font-size: .85rem; font-weight: 600; }
  .join { background: var(--bg); transition: transform .2s; }
  .join:hover { transform: translateY(-3px); }
  .join p { display: flex; align-items: center; gap: 6px; color: var(--accent); }
  @media (max-width: 860px) { .partner-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .steps-title { margin: 40px 0 20px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .steps li { padding: 24px; border-radius: var(--radius); background: var(--bg); }
  .step-num { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--accent); font: 700 1rem var(--font-head); margin-bottom: 14px; }
  .steps h4 { margin-bottom: 8px; }
  .steps p { font-size: .88rem; color: var(--text-muted); }
  @media (max-width: 860px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }

  .about { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .about img { width: 100%; max-width: 438px; border-radius: var(--radius); border: 2px solid var(--accent); box-shadow: var(--glow); }
  .about p { margin-top: 18px; max-width: 36rem; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 36px; }
  .stats div { display: flex; flex-direction: column; gap: 4px; font-size: .85rem; color: var(--text-muted); }
  .big { font: 700 2.6rem/1 var(--font-head); color: var(--text); }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } .stats { grid-template-columns: 1fr; } }

</style>
