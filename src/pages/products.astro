---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import { heroVideos, ctaBackgrounds, site } from '../data/site';
import { featuredProducts, products } from '../data/products';

const demo = (name: string, subject = 'Demo request') => `mailto:${site.email}?subject=${encodeURIComponent(`${subject}: ${name}`)}`;
---
<Base title="Products | Techtonnik" description="Things we've built in-house. Like something here? Ask for a demo, or let us build something like it for you.">
  <Hero video={heroVideos.space} short>
    <h1 class="h-lg">Built <span class="hl">in-house</span></h1>
    <p class="lead">A few things we've built along the way. Like something here? Ask for a demo, or let us build something like it for you.</p>
  </Hero>

  <section class="section container">
    {featuredProducts.map((f, i) => (
      <article class:list={['featured', { flip: i % 2 === 1 }]}>
        <DeviceMockup {...f.mockup} />
        <div class="featured-body">
          <img class="featured-logo" src={f.logo} alt={f.name} loading="lazy" />
          <h2 class="h-md">{f.tagline}</h2>
          <p>{f.text}</p>
          <ul class="tags">{f.tags.map((t) => <li>{t}</li>)}</ul>
          <a class="btn btn-primary" href={demo(f.name, f.request?.subject)}>{f.request?.label ?? 'Request a Demo'}</a>
        </div>
      </article>
    ))}

    <div class="grid">
      {products.map((p) => (
        <article class="product">
          <div class="logo">
            {p.logo ? <img src={p.logo} alt="" loading="lazy" /> : <span class="initial" aria-hidden="true">{p.name[0]}</span>}
          </div>
          <h3 class="h-sm">{p.name}</h3>
          <p class="tagline">{p.tagline}</p>
          <p class="text">{p.text}</p>
          <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
          {p.link ? (
            <a class="go" href={p.link.href} target="_blank" rel="noopener">{p.link.label} <Icon name="external" size={15} /></a>
          ) : (
            <a class="go" href={demo(p.name, p.request?.subject)}>{p.request?.label ?? 'Request a demo'} <Icon name="arrow" size={15} /></a>
          )}
        </article>
      ))}
    </div>
  </section>

  <Cta title="Want something like this?" text="Every product here started as a problem worth solving. Tell us yours." button="Get in Touch" image={ctaBackgrounds.earth} />
</Base>

<style>
  :global(main .hero.short) { min-height: 360px; }
  :global(main .hero-content) { padding-top: 96px; padding-bottom: 40px; }

  .featured { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); align-items: center; padding: clamp(16px, 2vw, 24px); border: 2px solid var(--purple); border-radius: var(--radius-lg); background: linear-gradient(135deg, #022338, #22083f); box-shadow: var(--glow); }
  .featured :global(.mockup) { border-radius: var(--radius); }
  .featured-body { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding-right: clamp(0px, 2vw, 24px); }
  .featured-logo { height: 40px; width: auto; }
  .featured-body p { font-size: .95rem; color: var(--text-muted); }
  .featured-body .btn { margin-top: 8px; }
  .featured + .featured { margin-top: 16px; }
  /* Every other featured product has its mockup on the right. */
  .featured.flip { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
  .featured.flip :global(.mockup) { order: 2; }
  .featured.flip .featured-body { padding-right: 0; padding-left: clamp(0px, 2vw, 24px); }
  @media (max-width: 860px) { .featured, .featured.flip { grid-template-columns: 1fr; } .featured.flip :global(.mockup) { order: 0; } .featured-body, .featured.flip .featured-body { padding: 0 8px 12px; } }

  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
  .product { display: flex; flex-direction: column; gap: 6px; padding: 22px; border: 2px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-raised); transition: border-color .2s, transform .2s; }
  .product:hover { border-color: var(--accent); transform: translateY(-2px); }
  .logo { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 8px; border-radius: 12px; background: rgba(255, 255, 255, .06); overflow: hidden; }
  .logo img { width: 100%; height: 100%; object-fit: contain; padding: 6px; }
  .initial { font: 700 1.4rem var(--font-head); color: var(--accent); }
  .tagline { font-size: .85rem; font-weight: 600; color: var(--accent); }
  .text { flex: 1; margin-top: 4px; font-size: .88rem; color: var(--text-muted); }

  .tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 8px 0 4px; padding: 0; }
  .tags li { padding: 3px 10px; border: 1px solid rgba(255, 255, 255, .18); border-radius: 999px; font-size: .72rem; font-weight: 500; color: var(--text-muted); }
  .go { display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; color: var(--accent); font-weight: 600; font-size: .88rem; }
  .go:hover { text-decoration: underline; }
</style>
