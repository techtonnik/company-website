---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { heroVideos, trustLogos, ctaBackgrounds, site } from '../data/site';

// Email-only contact: each shortcut opens the visitor's mail client with a subject filled in.
const mailto = (subject?: string) => `mailto:${site.email}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;
const shortcuts = [
  { icon: 'calendar', title: 'Join your team', text: 'Need a senior developer on an existing project, billed hourly?', subject: 'Joining our team' },
  { icon: 'laptop', title: 'Start a project', text: 'Have an idea or a product that needs building from scratch?', subject: 'New project' },
  { icon: 'network', title: 'Become a partner', text: 'Run a company that could be a good fit for our network?', subject: 'Partnership opportunity' },
];
---
<Base title="Contact | Techtonnik" description="Send us an email, and let's build something great together.">
  <Hero video={heroVideos.cubes} short>
    <h1 class="h-lg">Let's Talk!</h1>
    <p class="lead">Send us an email, and let's build something great together.</p>
  </Hero>

  <section class="section container">
    <div class="card email-card">
      <p class="eyebrow">Email us directly</p>
      <a class="address" href={mailto()}>{site.email}</a>
      <div class="btn-row">
        <a class="btn btn-primary" href={mailto()}><Icon name="mail" size={18} /> Write an Email</a>
        <button class="btn btn-ghost on-dark copy" type="button" data-copy={site.email}>
          <span data-copy-label>Copy address</span>
        </button>
      </div>
      <p class="note">A few lines about what you need is plenty. Stevan reads every message personally.</p>
    </div>

    <div class="shortcuts">
      {shortcuts.map((s) => (
        <a class="shortcut" href={mailto(s.subject)}>
          <Icon name={s.icon} size={30} class="s-icon" />
          <h2 class="h-sm">{s.title}</h2>
          <p>{s.text}</p>
          <span class="go">Email about this <Icon name="arrow" size={16} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="container trust">
    <h2 class="h-md center">Trusted by</h2>
    <div class="logos">
      {trustLogos.map((l) => <img src={l.src} alt={l.alt} loading="lazy" />)}
    </div>
  </section>

  <section class="again">
    <img src={ctaBackgrounds.earth} alt="" loading="lazy" />
    <div class="container inner">
      <h2 class="h-lg">Not sure yet? See what we can help with.</h2>
      <a class="btn btn-light accent-text" href="/services">All Services</a>
    </div>
  </section>
</Base>

<style>
  :global(main .hero.short) { min-height: 440px; }
  :global(main .hero-content) { padding-top: 96px; padding-bottom: 40px; }

  .email-card { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: clamp(32px, 5vw, 56px) 24px; }
  .eyebrow { font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .address { font: 700 clamp(1.6rem, 4.5vw, 3rem)/1.15 var(--font-head); overflow-wrap: anywhere; transition: color .2s; }
  .address:hover { color: var(--accent); }
  .email-card .btn-row { justify-content: center; margin-top: 22px; }
  .copy { background: none; border: 0; cursor: pointer; }
  .note { margin-top: 18px; font-size: .9rem; color: var(--text-muted); }

  .shortcuts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
  .shortcut { display: flex; flex-direction: column; gap: 10px; padding: 26px; border: 2px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-raised); transition: border-color .2s, transform .2s; }
  .shortcut:hover { border-color: var(--accent); transform: translateY(-3px); }
  .shortcut :global(.s-icon) { color: var(--accent); }
  .shortcut p { flex: 1; font-size: .92rem; color: var(--text-muted); }
  .go { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 600; font-size: .88rem; }
  @media (max-width: 760px) { .shortcuts { grid-template-columns: 1fr; } }

  .trust { padding-block: 16px 64px; }
  .trust h2 { max-width: 26rem; margin-inline: auto; }
  .logos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; align-items: center; justify-items: center; margin-top: 36px; }
  .logos img { max-height: 56px; width: auto; max-width: min(200px, 100%); object-fit: contain; }
  /* Wordmark-only logos read larger, so cap them lower. */
  .logos img[alt='Cinnamon'] { max-height: 26px; }
  .logos img[alt='CodeIT'] { max-height: 44px; }
  @media (max-width: 760px) { .logos { grid-template-columns: 1fr 1fr; } }

  .again { position: relative; isolation: isolate; overflow: hidden; }
  .again img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .again::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(3, 169, 244, .6); }
  .again .inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-block: 48px; }
  .again h2 { max-width: 46rem; }
  .again .btn { min-width: 240px; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = 'Copied!';
      } catch {
        // Clipboard can be blocked (e.g. insecure context); show the address so it can be copied by hand.
        label.textContent = btn.dataset.copy!;
      }
      setTimeout(() => (label.textContent = 'Copy address'), 2000);
    });
  });
</script>
