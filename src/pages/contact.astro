---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { heroVideos, trustLogos, ctaBackgrounds, site } from '../data/site';

// Set PUBLIC_FORM_ENDPOINT (e.g. a Formspree or Web3Forms URL) to deliver submissions.
// Without it, the form falls back to opening the visitor's email client.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const reasons = ['Project Request', 'General Questions', 'Partnership Opportunity', 'Other'];
---
<Base title="Contact Us | techtonnik" description="Drop us a message, and let's create something amazing together!">
  <Hero video={heroVideos.cubes} short>
    <h1 class="h-lg">Hit Us Up!</h1>
    <p class="lead">Drop us a message, and let's create something amazing together!</p>
  </Hero>

  <section class="section container contact">
    <form class="form" data-form data-endpoint={endpoint} data-email={site.email} novalidate>
      <h2 class="h-md">Let's Talk!</h2>
      <div class="fields">
        <label>
          <span>Full Name *</span>
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          <span>Reason for Inquiry *</span>
          <select name="reason" required>
            <option value="" selected disabled hidden></option>
            {reasons.map((r) => <option value={r}>{r}</option>)}
          </select>
        </label>
        <label>
          <span>Email *</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>Phone</span>
          <input name="phone" type="tel" autocomplete="tel" />
        </label>
        <label class="full">
          <span>Message</span>
          <textarea name="message" rows="5"></textarea>
        </label>
      </div>
      <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn btn-primary submit" type="submit">Submit</button>
      <p class="status" role="status" data-status></p>
      <p class="consent">By submitting this form, you agree to our <a href="/privacy-policy">Privacy Policy.</a></p>
    </form>

    <div class="trust">
      <h2 class="h-md center">They've already given us their trust:</h2>
      <div class="logos">
        {trustLogos.map((l) => <img src={l.src} alt={l.alt} loading="lazy" />)}
      </div>
    </div>
  </section>

  <section class="again">
    <img src={ctaBackgrounds.earth} alt="" loading="lazy" />
    <div class="container inner">
      <h2 class="h-lg">Or you can take a look at what we offer again!</h2>
      <a class="btn btn-light accent-text" href="/services">All Services</a>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: start; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 26px; margin-top: 28px; }
  .full { grid-column: 1 / -1; }
  label span { display: block; font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .02em; margin-bottom: 8px; }
  input, select, textarea {
    width: 100%; padding: 12px 14px; border: 2px solid var(--accent); border-radius: 6px;
    background: #fff; color: #000; font: 500 1rem var(--font-body);
  }
  textarea { resize: vertical; background: #3a3f48; color: var(--text); }
  input:focus, select:focus, textarea:focus { outline: none; box-shadow: var(--glow-blue); }
  input[aria-invalid='true'], select[aria-invalid='true'] { border-color: #ff4d4f; }
  .hp { position: absolute; left: -9999px; }
  .submit { width: 100%; margin-top: 26px; }
  .status { min-height: 1.5em; margin-top: 12px; font-weight: 500; }
  .status.ok { color: #4ade80; }
  .status.err { color: #ff6b6b; }
  .consent { font-size: .92rem; }
  .consent a { color: var(--accent); text-decoration: underline; }
  .trust h2 { max-width: 26rem; margin-inline: auto; }
  .logos { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 32px; align-items: center; justify-items: center; margin-top: 48px; }
  .logos img { max-height: 110px; width: auto; max-width: 100%; object-fit: contain; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .fields { grid-template-columns: 1fr; } }

  .again { position: relative; isolation: isolate; overflow: hidden; }
  .again img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .again::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(3, 169, 244, .6); }
  .again .inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-block: 64px; }
  .again h2 { max-width: 46rem; }
  .again .btn { min-width: 240px; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const setStatus = (msg: string, kind: 'ok' | 'err' | '' = '') => {
    status.textContent = msg;
    status.className = `status ${kind}`;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const required = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')];
    let valid = true;
    for (const el of required) {
      const ok = el.checkValidity();
      el.setAttribute('aria-invalid', String(!ok));
      valid &&= ok;
    }
    if (!valid) return setStatus('Please fill in all required fields with valid values.', 'err');

    const data = new FormData(form);
    if (data.get('_gotcha')) return; // bot
    const endpoint = form.dataset.endpoint;

    if (!endpoint) {
      const body = `Name: ${data.get('name')}\nEmail: ${data.get('email')}\nPhone: ${data.get('phone') || '-'}\n\n${data.get('message') || ''}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(String(data.get('reason')))}&body=${encodeURIComponent(body)}`;
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    button.disabled = true;
    setStatus('Sending…');
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      setStatus("Thanks for submitting! We'll get back to you soon.", 'ok');
    } catch {
      setStatus(`Something went wrong. Please email us at ${form.dataset.email}.`, 'err');
    } finally {
      button.disabled = false;
    }
  });
</script>
