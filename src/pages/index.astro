---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Icon from '../components/Icon.astro';
import Testimonials from '../components/Testimonials.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import Cta from '../components/Cta.astro';
import { heroVideos, ctaBackgrounds, media } from '../data/site';
import { partners } from '../data/showcase';
import { featured, featuredHref } from '../data/projects';
import { isExternal } from '../lib/rich';

const ways = [
  {
    icon: 'calendar',
    title: 'Join your team',
    tag: 'Most common',
    text: 'Stevan joins your existing project as a senior developer, billed hourly. No fixed end date: we stay on for as long as you need, alongside your own people.',
  },
  {
    icon: 'laptop',
    title: 'Build it with us',
    text: "Starting from scratch? We take the product from idea to launch, and keep maintaining it afterwards.",
  },
  {
    icon: 'team',
    title: 'We assemble the team',
    text: 'For bigger apps, we put together the right developers, designers and QA from our network, with Stevan as your single point of contact.',
  },
  {
    icon: 'network',
    title: 'We connect you',
    text: "If another company is a better fit for what you need, we'll introduce you to them. You get the right team, even when it isn't ours.",
  },
];

const linkAttrs = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});

const strengths: Record<string, string> = {
  CodeIT: 'Established software company',
  'Zenith Digital': 'Web presentations, fast',
  Genroks: 'AI for ISO compliance',
  'kopirajter.rs': 'Copywriting & brand strategy',
  TrinitySmartIT: 'On-demand development teams',
  helixconnect: 'Innovation & NGO projects',
  Tremium: 'Software development',
  Cinnamon: 'Design, development & deployment',
  Cognitika: 'Educational game studio',
};
const network = partners.map((p) => ({ logo: p.logo, name: p.logoAlt, text: strengths[p.logoAlt], href: p.links[0].href }));

const steps = [
  { title: 'Tell us what you need', text: 'A short call about your product, timeline and budget. No sales pitch.' },
  { title: 'We assess the fit', text: "We'll tell you honestly whether to join your team, bring in more people, or point you to a partner." },
  { title: 'Work starts, hourly', text: 'Clear hourly rates agreed up front. No long contracts, and you only pay for the time actually spent.' },
  { title: 'Scale as you go', text: 'Add people, pause, or wrap up at any point. Stevan stays your point of contact throughout.' },
];

---
<Base title="World-class On-Demand Software Development | Techtonnik" description="Building AI-powered web, mobile and desktop apps: by joining your team, assembling the right one, or connecting you with the partner that fits your project best.">
  <Hero video={heroVideos.home}>
    <h1 class="h-xl">Quality solutions of the<br class="br-wide" /> <span class="hl">highest magnitude</span></h1>
    <p class="lead hero-lead">Building AI-powered web, mobile and desktop apps: by joining your team, assembling the right one, or connecting you with the partner that fits your project best.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/contact">Start a Project</a>
      <a class="btn btn-ghost" href="/partners">Meet the Network <Icon name="chevrons" size={20} /></a>
    </div>
  </Hero>

  <Marquee />

  <!-- Three ways to work -->
  <section class="section container">
    <div class="center head">
      <h2 class="h-lg">One contact, <span class="hl">four ways</span> to get it built</h2>
      <p>Most work is ongoing and hourly: joining a project that's already moving, not just delivering one-off builds.</p>
    </div>
    <div class="ways">
      {ways.map((w, i) => (
        <div class:list={['card', 'way', { purple: i === 0 }]}>
          <span class="num">0{i + 1}</span>
          <Icon name={w.icon} size={40} class="way-icon" />
          {w.tag && <span class="tag">{w.tag}</span>}
          <h3 class="h-md">{w.title}</h3>
          <p>{w.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured apps -->
  <section class="section container">
    <div class="section-head">
      <div>
        <h2 class="h-lg">Apps we've <span class="hl">helped build</span></h2>
        <p>Platforms, web and mobile apps, delivered directly or together with partners.</p>
      </div>
      <a class="btn btn-primary" href="/case-studies">All Projects</a>
    </div>
    <div class="apps">
      {featured.map((app) => (
        <article class="app">
          <a href={featuredHref(app)} {...linkAttrs(featuredHref(app))} class="app-media">
            <DeviceMockup
              desktop={`/mockups/${app.mockup}-desktop.jpg`}
              mobile={`/mockups/${app.mockup}-mobile.jpg`}
              url={app.site}
              label={app.label}
              tint={app.tint}
              alt={`${app.title} website`}
            />
          </a>
          <div class="app-body">
            <p class="scope">{app.scope}</p>
            <h3 class="h-sm">
              <a href={featuredHref(app)} {...linkAttrs(featuredHref(app))}>{app.title}</a>
              {app.via && (
                <span class="via">via <a href={app.via.href} target="_blank" rel="noopener">{app.via.name}</a></span>
              )}
              {app.client && (
                <span class="via">for <a href={app.client.href} target="_blank" rel="noopener">{app.client.name}</a></span>
              )}
            </h3>
            <p>{app.tagline}</p>
          </div>
        </article>
      ))}
    </div>

  </section>

  <!-- Network -->
  <section class="network">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h-lg">The <span class="hl-dark">network</span> behind the work</h2>
          <p>Trusted companies and specialists we work with, and introduce clients to when they're the better fit.</p>
        </div>
        <a class="btn btn-light accent-text" href="/partners">All Partners</a>
      </div>
      <div class="partner-grid">
        {network.map((p) => (
          <a class="partner" href={p.href} target="_blank" rel="noopener">
            <img src={p.logo} alt={p.name} loading="lazy" />
            <p>{p.text}</p>
          </a>
        ))}
      </div>
      <a class="join" href="/contact">
        <span class="h-sm">Your company?</span>
        <span class="join-cta">Become a partner <Icon name="arrow" size={16} /></span>
      </a>

      <h3 class="h-md steps-title">How a match works</h3>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <h4 class="h-sm">{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Testimonials />

  <!-- About -->
  <section class="section container about">
    <img src={media('cce622_48e5e8feccb34fe580821d2107417bfc')} alt="Stevan Radovanović" width="340" height="425" loading="lazy" />
    <div>
      <h2 class="h-lg">About <span class="hl">Techtonnik</span></h2>
      <p>Techtonnik is a solo software development business, founded and run by Stevan Radovanović. It started with a simple goal: do software development properly, with honest communication, clean code and long-term support. Along the way, Stevan has worked with dozens of clients and connected many of them with the people best suited to their projects.</p>
      <p>Today, Techtonnik pairs Stevan's senior development work with a network of trusted partners, so every project ends up in the right hands.</p>
      <div class="stats">
        <div><span class="big">25+</span><span>Projects delivered</span></div>
        <div><span class="big">1000+</span><span>Years of combined experience across the network</span></div>
        <div><span class="big">{network.length}</span><span>Partner companies</span></div>
      </div>
    </div>
  </section>

  <Cta title="Got a project in mind?" text="Tell us about it, and we'll make sure it ends up with the right team." button="Start a Project" image={ctaBackgrounds.satellite} />
</Base>

<style>
  /* Hero fills the first screen, leaving the logo strip visible at the bottom. */
  :global(main .hero) { min-height: clamp(540px, calc(100svh - 80px), 860px); }
  :global(main .hero-content) { padding-top: 96px; padding-bottom: 40px; }
  .hero-lead { max-width: 44rem; font-size: clamp(1.05rem, 1.5vw, 1.25rem); text-wrap: pretty; }
  @media (max-width: 640px) { .br-wide { display: none; } }

  .head { max-width: 40rem; margin: 0 auto 32px; }
  .head p { margin-top: 14px; font-weight: 500; }
  .ways { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 1080px) { .ways { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .ways { grid-template-columns: 1fr; } }
  .way { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 30px 26px; }
  .tag { padding: 3px 10px; border-radius: 999px; background: var(--purple); font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  .way :global(.way-icon) { color: var(--accent); }
  .way.purple :global(.way-icon) { color: #c48bff; }
  .num { position: absolute; top: 22px; right: 26px; font: 700 2.2rem/1 var(--font-head); opacity: .18; }
  .way p { font-size: .95rem; }

  .apps { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; }
  .app { flex: 0 1 calc((100% - 48px) / 3); display: flex; flex-direction: column; border: 2px solid rgba(255,255,255,.14); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-raised); transition: border-color .2s, transform .2s; }
  .app:hover { border-color: var(--accent); transform: translateY(-3px); }
  .app-media { display: block; }
  .app-body { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 6px; }
  .app-body h3 { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; }
  .app-body h3 > a:hover { color: var(--accent); }
  .via { font: 500 .85rem var(--font-body); color: var(--text-muted); }
  .via a { color: var(--accent); font-weight: 600; }
  .via a:hover { text-decoration: underline; }
  .app-body p:last-child { font-size: .9rem; color: var(--text-muted); }
  .scope { font-size: .75rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--accent); }
  @media (max-width: 900px) { .app { flex-basis: calc((100% - 24px) / 2); } }
  @media (max-width: 560px) { .app { flex-basis: 100%; } }


  .network { background: var(--accent); padding-block: clamp(40px, 5vw, 64px); margin-block: clamp(20px, 3vw, 40px); }
  .network .section-head p { font-weight: 500; }
  .hl-dark { color: var(--bg); }
  .partner-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .partner { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; min-height: 160px; padding: 24px 18px; border-radius: var(--radius); background: rgba(0, 4, 13, .22); text-align: center; }
  .partner img { max-height: 52px; max-width: 80%; width: auto; object-fit: contain; }
  .partner { transition: background .2s, transform .2s; }
  .partner:hover { background: rgba(0, 4, 13, .38); transform: translateY(-2px); }
  .partner p { font-size: .85rem; font-weight: 600; }
  /* Wide wordmark-only logo: shrink to sit level with the others. */
  .partner img[alt='Cinnamon'] { max-height: 34px; }
  .join { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 14px; padding: 20px 28px; border-radius: var(--radius); background: var(--bg); transition: transform .2s; }
  .join:hover { transform: translateY(-2px); }
  .join-cta { display: flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 600; font-size: .9rem; }
  @media (max-width: 860px) { .partner-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .steps-title { margin: 40px 0 20px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .steps li { padding: 24px; border-radius: var(--radius); background: var(--bg); }
  .step-num { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--accent); font: 700 1rem var(--font-head); margin-bottom: 14px; }
  .steps h4 { margin-bottom: 8px; }
  .steps p { font-size: .88rem; color: var(--text-muted); }
  @media (max-width: 860px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }

  .about { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  .about img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; border-radius: var(--radius); border: 2px solid var(--accent); box-shadow: var(--glow); }
  .about p { margin-top: 14px; max-width: 40rem; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 28px; }
  .stats div { display: flex; flex-direction: column; gap: 4px; font-size: .85rem; color: var(--text-muted); }
  .big { font: 700 2.6rem/1 var(--font-head); color: var(--text); }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } .about img { max-width: 300px; } .stats { grid-template-columns: 1fr; } }

</style>
