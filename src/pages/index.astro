---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Icon from '../components/Icon.astro';
import EngagementModels from '../components/EngagementModels.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import PostCard from '../components/PostCard.astro';
import { site, heroVideos, portfolio, testimonials, homeFaq, ctaBackgrounds, media } from '../data/site';
import { homeOffers, homeMore } from '../data/services';
import { isExternal } from '../lib/rich';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.pubDate - +a.data.pubDate).slice(0, 3);
const featured = testimonials.find((t) => t.name === 'Nikola Terzić')!;
const [webDev, ...otherOffers] = homeOffers;
---
<Base title="World-class On-Demand Software Development Agency | techtonnik">
  <Hero video={heroVideos.home}>
    <h1 class="h-xl">Quality solutions of the<br /> <span class="hl">highest magnitude</span></h1>
    <p class="lead"><span class="hl">techtonnik</span> is a software development agency that offers world-class, on-demand solutions.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/contact">Let's Collaborate!</a>
      <a class="btn btn-ghost" href="/case-studies">Case Studies <Icon name="chevrons" size={20} /></a>
    </div>
    <div class="hero-aside">
      <figure class="mini-quote">
        <blockquote>A fast-pace and easy to work with team. I highly recommend them and will gladly speak on their behalf!</blockquote>
        <figcaption class="hl">{featured.name}, {featured.role}</figcaption>
        <img src={media('cce622_6c0678d22f654b6880f9be63949e2117')} alt="" width="78" height="78" />
      </figure>
      <a class="partner-badge" href={site.designrush} target="_blank" rel="noopener">
        Proud Partners Of <strong>DesignRush</strong>
      </a>
    </div>
  </Hero>

  <Marquee />

  <!-- Portfolio -->
  <section class="section">
    <div class="container section-head">
      <h2 class="h-lg">Take a peak into our <span class="hl">portfolio</span></h2>
      <a class="btn btn-primary" href="/case-studies">Case Studies</a>
    </div>
    <div class="portfolio" tabindex="0" aria-label="Portfolio">
      {portfolio.map((p) => (
        <a class="work" href={p.href} {...(isExternal(p.href) ? { target: '_blank', rel: 'noopener' } : {})}>
          <img src={p.img} alt={`${p.title} preview`} loading="lazy" width="576" height="377" />
          <p class="work-title">{p.title}</p>
          <p class="work-tags">{p.tags}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- About / stats -->
  <section class="section container">
    <h2 class="h-lg">techtonn-<span class="hl">who?</span></h2>
    <div class="stats">
      <div class="tile wide blue" style={`--bg:url(${media('cce622_48fa662757be4c5abb94941258c40637')})`}>
        <h3 class="h-md">Industry level work with premium long-term support</h3>
        <p>We code, you conquer. Long-term support, short-term worries.</p>
      </div>
      <div class="tile purple center-tile" style={`--bg:url(${media('cce622_30a8c978a2b043b1b295eaa9e3045db0')})`}>
        <p class="big">25+</p>
        <h3 class="h-md">Projects Completed</h3>
      </div>
      <div class="tile purple center-tile" style={`--bg:url(${media('cce622_08d755c88b9e4d64a3cec4933c047df8')})`}>
        <p class="big">100+</p>
        <h3 class="h-md">Combined YoE</h3>
      </div>
      <div class="tile wide blue right" style={`--bg:url(${media('cce622_1af50dad33b540b0a985d9da3f055f75')})`}>
        <h3 class="h-md">Driven by motivation-fueled success strategies</h3>
        <p>Your success is our script. Let's debug the future together.</p>
      </div>
    </div>
  </section>

  <Marquee wordmark />

  <!-- Services -->
  <section class="section container">
    <div class="section-head">
      <h2 class="h-lg">What do we <span class="hl">offer?</span></h2>
      <a class="btn btn-primary" href="/contact">Let's Talk!</a>
    </div>
    <div class="offers">
      <a class="offer big-offer" href={webDev.href}>
        <img src={webDev.img} alt="" loading="lazy" />
        <h3 class="h-sm">{webDev.title} <Icon name="external" size={18} /></h3>
        <p>{webDev.text}</p>
      </a>
      {otherOffers.map((o, i) => (
        <a class:list={['offer', { 'wide-offer': i === 0 }]} href={o.href}>
          <img src={o.img} alt="" loading="lazy" />
          <h3 class="h-sm">{o.title} <Icon name="external" size={18} /></h3>
          <p>{o.text}</p>
        </a>
      ))}
    </div>

    <div class="more">
      <div class="more-grid">
        {homeMore.map((s) => (
          <a class="pill" href="/services">{s.title} <Icon name={s.icon} size={26} /></a>
        ))}
      </div>
      <div class="more-text">
        <h2 class="h-lg">&amp; much more!</h2>
        <p>We are fully prepared to tackle any kind of request you send our way! There are no impossible obstacles for a well-oiled machine.</p>
        <a class="btn btn-primary" href="/services">All Services</a>
      </div>
    </div>
  </section>

  <EngagementModels />
  <Testimonials />

  <!-- Founder -->
  <section class="founder">
    <div class="container founder-inner">
      <div>
        <h2 class="h-lg">A word or two from our founder</h2>
        <blockquote>"Being passionate about our craft is our key to success! I've poured my heart and soul into making techtonnik what it is today, and I've had help from some amazing individuals along the way."</blockquote>
        <p class="sig">- Stevan Radovanović</p>
      </div>
      <img src={media('cce622_48e5e8feccb34fe580821d2107417bfc')} alt="Stevan Radovanović" loading="lazy" width="438" height="572" />
    </div>
  </section>

  <Faq items={homeFaq} />

  <!-- Blog -->
  <section class="section container">
    <div class="section-head">
      <h2 class="h-lg">Insights, <span class="hl">stories,</span> updates!</h2>
      <a class="btn btn-primary" href="/blog">All Blogs</a>
    </div>
    <div class="grid grid-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <Cta title="Kickstart your project!" image={ctaBackgrounds.satellite} />
</Base>

<style>
  .hero-aside { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; margin-top: 72px; }
  .mini-quote { display: grid; grid-template-columns: minmax(0, 1fr) 78px; gap: 6px 18px; margin: 0; max-width: 520px; text-align: right; font-size: .92rem; }
  .mini-quote img { grid-column: 2; grid-row: 1 / 3; width: 78px; height: 78px; object-fit: cover; border-radius: 4px; }
  .mini-quote blockquote { margin: 0; font-weight: 500; }
  .mini-quote figcaption { font-weight: 600; }
  .partner-badge { font: 600 1rem var(--font-head); }
  .partner-badge strong { margin-left: 6px; color: var(--accent); }

  .portfolio { display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px var(--gutter) 18px; scrollbar-width: thin; scrollbar-color: var(--accent) transparent; }
  .work { flex: 0 0 min(576px, 82vw); scroll-snap-align: start; }
  .work img { width: 100%; aspect-ratio: 576 / 377; object-fit: cover; border: 2px solid transparent; border-radius: 6px; transition: border-color .2s; }
  .work:hover img { border-color: var(--accent); }
  .work-title { margin-top: 18px; color: var(--accent); font-weight: 600; }
  .work-tags { font-size: .9rem; }

  .stats { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); grid-template-areas: 'a a a a a b b b' 'c c c d d d d d'; gap: 14px; margin-top: 40px; }
  .stats .tile:nth-child(1) { grid-area: a; }
  .stats .tile:nth-child(2) { grid-area: b; }
  .stats .tile:nth-child(3) { grid-area: c; }
  .stats .tile:nth-child(4) { grid-area: d; }
  .tile { position: relative; isolation: isolate; overflow: hidden; min-height: 370px; padding: 40px; border-radius: var(--radius); display: flex; flex-direction: column; justify-content: flex-end; gap: 12px; box-shadow: var(--glow); }
  .tile::before { content: ''; position: absolute; inset: 0; z-index: -2; background: var(--bg) center / cover; }
  .tile::after { content: ''; position: absolute; inset: 0; z-index: -1; opacity: .82; }
  .tile.blue::after { background: var(--accent); }
  .tile.purple::after { background: var(--purple); }
  .tile.right { text-align: right; align-items: flex-end; }
  .tile p:not(.big) { font-weight: 500; font-size: .95rem; }
  .center-tile { justify-content: center; align-items: center; text-align: center; }
  .big { font: 700 clamp(4rem, 8vw, 6.5rem)/1 var(--font-head); }
  @media (max-width: 760px) {
    .stats { grid-template-columns: 1fr; grid-template-areas: 'a' 'b' 'c' 'd'; }
    .tile { min-height: 260px; padding: 28px; }
  }

  .offers { display: grid; grid-template-columns: 1.9fr 1fr 1fr; grid-template-areas: 'big wide wide' 'big s1 s2'; gap: 24px 30px; align-items: start; }
  .big-offer { grid-area: big; }
  .wide-offer { grid-area: wide; }
  .offer img { width: 100%; border-radius: 10px; border: 2px solid var(--text); object-fit: cover; }
  .big-offer img { aspect-ratio: 607 / 601; }
  .wide-offer img { aspect-ratio: 642 / 253; }
  .offer:not(.big-offer):not(.wide-offer) img { aspect-ratio: 4 / 3; }
  .offer h3 { display: flex; justify-content: space-between; align-items: center; margin-top: 18px; }
  .offer h3 :global(svg) { color: var(--accent); }
  .offer p { margin-top: 8px; font-size: .9rem; }
  .offer:hover h3 { color: var(--accent); }
  @media (max-width: 860px) {
    .offers { grid-template-areas: 'big big' 'wide wide' 's1 s2'; grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .offers { grid-template-areas: none; grid-template-columns: 1fr; }
    .big-offer, .wide-offer { grid-area: auto; }
  }

  .more { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 48px; align-items: center; margin-top: 88px; }
  .more-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pill { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 86px; padding: 0 24px; background: var(--accent); border-radius: 10px; box-shadow: var(--glow); font: 600 1.15rem var(--font-head); transition: transform .15s; }
  .pill:hover { transform: translateY(-2px); }
  .more-text p { margin: 18px 0 30px; font-weight: 500; }
  @media (max-width: 860px) { .more { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .more-grid { grid-template-columns: 1fr; } }

  .founder { background: var(--accent); padding-block: 64px; margin-block: 40px; }
  .founder-inner { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .founder blockquote { margin: 24px 0 16px; font-size: clamp(1.1rem, 1.8vw, 1.4rem); font-weight: 600; max-width: 32rem; }
  .sig { font: 600 1.3rem var(--font-head); }
  .founder img { justify-self: end; width: min(438px, 100%); border-radius: 6px; border: 2px solid var(--text); box-shadow: 0 0 28px rgba(0,0,0,.25); }
  @media (max-width: 760px) { .founder-inner { grid-template-columns: 1fr; } .founder img { justify-self: start; } }
</style>
